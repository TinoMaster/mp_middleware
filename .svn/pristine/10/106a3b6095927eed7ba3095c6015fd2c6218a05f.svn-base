# =============================================================================
# Configurazione di deployment - mypay.mypaycore
# Completare tutti i valori <INSERIRE ...> prima del deploy
# =============================================================================

# --- Database PA (PostgreSQL) ---
# Nota: usare il prefisso spring.datasource.pa.* (gestito da DataSourceConfiguration.java)
spring.datasource.pa.driver-class-name=org.postgresql.Driver
spring.datasource.pa.url=jdbc:postgresql://<INSERIRE IP>:<INSERIRE PORT>/<INSERIRE DB_NAME>
spring.datasource.pa.username=<INSERIRE USER>
spring.datasource.pa.password=<INSERIRE PASSWORD>
spring.datasource.pa.hikari.minimum-idle=1
spring.datasource.pa.hikari.maximum-pool-size=5
spring.datasource.pa.hikari.idle-timeout=30000
spring.datasource.pa.hikari.max-lifetime=60000

# --- Server ---
server.port=8443
server.ssl.key-store=certs/lispa.local.p12
server.ssl.key-store-type=PKCS12
server.ssl.key-alias=lispa.local
server.ssl.key-store-password=<INSERIRE PASSWORD>
server.ssl.enabled=true
server.ssl.enabled-protocols=TLSv1.2
server.ssl.protocol=TLS

# --- SpringLine2 ---
spl.http.logging.app.enabled=true
spl.client-rest.logging.app.enabled=true
spl.client-ws.logging.app.enabled=true
spl.open-api.authorize.idpc=true
spl.security.jwt.cypher-secret=<INSERIRE SECRET TOKEN>


# --- Configurazione aggiuntiva ---
spring-line.version=2027.01.01
spring.application.name=middleware

# --- Configurazione logging ---
logging.level.root=INFO
logging.level.it.ariaspa.mypay.mypaycore.api.=DEBUG
logging.level.org.springframework.web.filter.CommonsRequestLoggingFilter=DEBUG
logging.level.org.springframework.ws.server.MessageTracing=${LOGLEVEL_MESSAGETRACING:${logging.level.root}}
logging.level.org.springframework.ws.client.MessageTracing=${LOGLEVEL_MESSAGETRACING:${logging.level.root}}

# --- Logback: posizione del file di configurazione e directory log ---
# Completare con i valori appropriati per l'ambiente di deploy
logging.config=
logging.file.dir=
